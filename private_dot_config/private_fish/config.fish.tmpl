eval (/opt/homebrew/bin/brew shellenv)

fish_add_path "$HOME/.local/bin"
fish_add_path "$HOME/.bun/bin"
{{ if eq .profile "work" }}
# ASDF configuration code
if test -z $ASDF_DATA_DIR
    set _asdf_shims "$HOME/.asdf/shims"
else
    set _asdf_shims "$ASDF_DATA_DIR/shims"
end

# Do not use fish_add_path (added in Fish 3.2) because it
# potentially changes the order of items in PATH
if not contains $_asdf_shims $PATH
    set -gx --prepend PATH $_asdf_shims
end
set --erase _asdf_shims
{{ end -}}
{{ if eq .profile "personal" }}
# Proto toolchain manager
set -gx PROTO_HOME "$HOME/.proto"
fish_add_path "$PROTO_HOME/shims"
fish_add_path "$PROTO_HOME/bin"
{{ end }}
# Apply Tide prompt configuration once (persisted in universal variables).
if not set -q tide_config_applied
    tide configure --auto --style=Lean --prompt_colors='True color' --show_time='24-hour format' --lean_prompt_height='Two lines' --prompt_connection=Dotted --prompt_connection_andor_frame_color=Lightest --prompt_spacing=Sparse --icons='Few icons'
    set -U tide_config_applied 1
end
{{ if eq .profile "personal" }}
# mise: Homebrew's vendor conf.d auto-activates mise *before* this file runs, so it
# snapshots PATH before brew shellenv has put Homebrew first, then re-applies that
# stale order on every prompt. Disable that early activation and activate here,
# after PATH is built, so mise captures the correct order.
set -q MISE_FISH_AUTO_ACTIVATE; or set -Ux MISE_FISH_AUTO_ACTIVATE 0
/opt/homebrew/bin/mise activate fish | source
{{ end -}}
