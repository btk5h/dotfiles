#:schema https://docs.jj-vcs.dev/latest/config-schema.json

[user]
name = "Bryan Terce"
email = "{{ .email }}"

[aliases]
home = ["util", "exec", "--", "sh", "-c", "jj git fetch && jj new 'trunk()'"]

[[--scope]]
--when.environments = ["CLAUDECODE"]
[--scope.ui]
editor = "false"
diff-editor = "false"
merge-editor = "false"

[signing]
behavior = "drop"
backend = "ssh"
key = "~/.ssh/id_rsa.pub"
backends.ssh.program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"

[git]
sign-on-push = true
